# Optional: docker compose works without a .env file. Copy to .env to override defaults.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_DB=aftershock
POSTGRES_USER=aftershock
POSTGRES_PASSWORD=aftershock

# Daily scheduled ingest (Celery beat), off by default. Enable after the first `make ingest`.
# COMPOSE_PROFILES=scheduler
